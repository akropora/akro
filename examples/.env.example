# Akro local configuration. Copy this file to .env.

# Main chat model. If AKRO_VISIBLE_MODELS is set and this model is not in it,
# Akro starts with the first installed model from the allowlist.
DEFAULT_MODEL="llama:latest"

# Optional comma-separated allowlist for /model.
# Leave blank to show every installed Ollama model.
AKRO_VISIBLE_MODELS=""

NEURON_MODEL="neuron:latest"
LIBRARIAN_MODEL="librarian:latest"
PROMPT_MODEL="coral1.6-prompt:latest"
AGENT_MODEL="coral1.6-agent:latest"
AKRO_EMBED_MODEL="embeddinggemma:latest"

# Optional web search.
TAVILY_API_KEY=""

# Set to 0 if you never want automatic long-term remembering.
AKRO_AUTO_LEARN=1

# Agentic. Defaults are intentionally modest for 8 GB Apple Silicon.
AGENT_MAX_STEPS=20
AGENT_NUM_CTX=8192
AGENT_NUM_PREDICT=1600
AGENT_MAX_READ_CHARS=18000
AGENT_MAX_TOOL_OUTPUT=12000
AGENT_MAX_WRITE_CHARS=50000
AGENT_CONTEXT_MAX_CHARS=2200
AGENT_CONFIRM_WRITES=1
AGENT_REPEAT_LIMIT=2
AGENT_SHOW_TOOLS=1
