# Copy this file to .env in the Akro repository.

# DEFAULT_MODEL=qwen3.5:4b
# NEURON_MODEL=neuron:latest
# LIBRARIAN_MODEL=librarian:latest
# AKRO_EMBED_MODEL=embeddinggemma:latest

# CHAT_NUM_CTX=16384
# CHAT_NUM_PREDICT=3000
# CHAT_HISTORY_MAX_CHARS=18000
# CHAT_HISTORY_MAX_MESSAGES=24

# BRAIN_MAX_NOTE_CONTEXT=4
# BRAIN_GLOBAL_NOTE_CONTEXT=2
# KNOWLEDGE_MAX_CONTEXT=3
# KNOWLEDGE_GLOBAL_CONTEXT=1
# KNOWLEDGE_CHUNK_CHARS=4500
# BRAIN_CONTEXT_MAX_CHARS=10000
# KNOWLEDGE_CONTEXT_MAX_CHARS=14000

# AKRO_AUTO_LEARN=1
# AKRO_SHOW_ACTIVITY=1

# TAVILY_API_KEY=your-key-here
# TAVILY_MAX_RESULTS=5

# AKRO_DATA_DIR=$HOME/.akro
