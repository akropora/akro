# Akro local configuration. Copy this file to .env.
DEFAULT_MODEL="llama:latest"
AKRO_VISIBLE_MODELS=""

NEURON_MODEL="neuron:latest"
LIBRARIAN_MODEL="librarian:latest"
AGENT_MODEL="coral1.6-agent:latest"
AKRO_EMBED_MODEL="embeddinggemma:latest"

# Optional live web search. Used by /search and by /agentic after approval.
TAVILY_API_KEY=""
AKRO_AUTO_LEARN=1

# Agentic v4 action loop.
AGENT_MAX_STEPS=12
AGENT_NUM_CTX=4096
AGENT_NUM_PREDICT=300
AGENT_CONTROLLER_NUM_CTX=8192
AGENT_CONTROLLER_NUM_PREDICT=900
AGENT_MAX_READ_CHARS=20000
AGENT_MAX_TOOL_OUTPUT=16000
AGENT_MAX_WRITE_CHARS=80000
AGENT_ACTION_MAX_CHARS=100000
AGENT_SHOW_TOOLS=1
AGENT_SHOW_PLAN=1
AGENT_SHOW_INSTRUCTIONS=1
AGENT_VERBOSE=1
AGENT_COMMAND_TIMEOUT=120
